---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`搜索 — ${SITE_TITLE}`} description="搜索博客的全部文章">
	<link slot="head" rel="stylesheet" href={`${base}pagefind/pagefind-ui.css`} />
	<script slot="head" is:inline src={`${base}pagefind/pagefind-ui.js`}></script>

	<main>
		<PageIntro kicker="Search — 搜索" title="找点什么" em="什么">
			<p>输入关键词搜索全部文章，支持中文分词与代码片段。</p>
		</PageIntro>

		<div id="search"></div>
		<p id="search-fallback" hidden>
			搜索索引仅在构建后的站点中可用（本地 dev 模式不生成索引）。
		</p>
		<noscript><p class="noscript-hint">搜索需要启用 JavaScript。</p></noscript>
	</main>

	<script>
		const mount = document.getElementById('search');
		const fallback = document.getElementById('search-fallback');
		// 索引由构建后置步骤（pagefind --site dist）生成，dev 下不存在
		if (window.pagefind && mount) {
			new window.pagefind.UI({
				element: '#search',
				showImages: false,
				showSubResults: true,
			});
		} else if (fallback) {
			fallback.hidden = false;
		}
	</script>
</BaseLayout>

<style>
	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 3em 1.5em 5em;
	}

	#search-fallback,
	.noscript-hint {
		padding: 1rem 1.25rem;
		border: 2px dashed var(--border-soft);
		border-radius: var(--radius);
		font-size: 0.88rem;
		color: rgb(var(--gray));
		line-height: 1.6;
	}

	/* Pagefind UI 配色对齐手绘风 */
	:global(#search) {
		--pagefind-ui-primary: #3498db;
		--pagefind-ui-text: rgb(var(--gray-dark));
		--pagefind-ui-background: var(--bg-surface);
		--pagefind-ui-border: rgba(44, 44, 44, 0.55);
		--pagefind-ui-tag: rgb(var(--gray-light));
		--pagefind-ui-border-width: 2px;
		--pagefind-ui-border-radius: 4px;
		--pagefind-ui-font: var(--font-atkinson), system-ui, sans-serif;
	}
</style>
