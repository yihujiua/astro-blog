---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import type { MarkdownHeading } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSortedPosts, relatedPosts } from '../../utils/posts';
import type { Post } from '../../utils/posts';

interface TocItem {
	text: string;
	id: string;
	level: number;
}

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, related: relatedPosts(post, posts) },
	}));
}

interface Props {
	post: Post;
	related: Post[];
}

const { post, related } = Astro.props;
const { title, description, pubDate, updatedDate, heroImage, tags } = post.data;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate ?? pubDate).toISOString(),
	author: { '@type': 'Person', name: 'yihujiua' },
	url: new URL(Astro.url.pathname, Astro.site).toString(),
	...(heroImage && { image: new URL(heroImage.src, Astro.site).toString() }),
};

// Flatten Astro's nested headings into a flat h2/h3 TOC list
function flattenHeadings(hs: MarkdownHeading[]): MarkdownHeading[] {
	return hs.flatMap((h) => [h, ...flattenHeadings(h.children ?? [])]);
}
const toc: TocItem[] = flattenHeadings(headings)
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ text: h.text, id: h.slug, level: h.depth }));
---

<BaseLayout title={title} description={description} type="article" image={heroImage}>
	<script slot="head" is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

	<div class="progress" aria-hidden="true">
		<div class="progress-bar" id="progress-bar"></div>
	</div>

	<main>
		<div class="shell">
			<div class="content">
				<a class="back" href={`${base}blog/`}>← 博客列表</a>

				{
					heroImage && (
						<div class="hero">
							<Image src={heroImage} alt="" width={1020} height={510} />
						</div>
					)
				}

				{
					tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => (
								<a class="tag" href={`${base}tags/${t}/`}>
									{t}
								</a>
							))}
						</div>
					)
				}

				<h1>{title}</h1>
				<div class="post-date">
					<FormattedDate date={pubDate} />
					{updatedDate && (
						<span class="last-updated">
							· 更新于 <FormattedDate date={updatedDate} />
						</span>
					)}
				</div>

				<article class="prose">
					<Content />
				</article>

				{
					related.length > 0 && (
						<section class="related">
							<h2>相关文章</h2>
							<div class="related-grid">
								{related.map((r) => (
									<a class="rel-card" href={`${base}blog/${r.id}/`}>
										<h3>{r.data.title}</h3>
										<div class="rel-tags">
											{r.data.tags.map((t) => (
												<span class="rel-tag">{t}</span>
											))}
										</div>
									</a>
								))}
							</div>
						</section>
					)
				}
			</div>

			{
				toc.length > 0 && (
					<aside class="toc">
						<p class="toc-title">目录</p>
						<ul>
							{toc.map((item) => (
								<li class={`lvl-${item.level}`}>
									<a href={`#${item.id}`}>{item.text}</a>
								</li>
							))}
						</ul>
					</aside>
				)
			}
		</div>
	</main>
</BaseLayout>

<style>
	:global(html) {
		scroll-behavior: smooth;
	}

	/* ── reading progress bar ── */
	.progress {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: transparent;
		z-index: 100;
	}
	.progress-bar {
		height: 100%;
		width: 0%;
		background: var(--accent);
		transition: width 0.1s linear;
	}

	main {
		width: 100%;
	}
	.shell {
		max-width: 1000px;
		margin: 0 auto;
		padding: 1.5em 1.5em 6em;
		display: grid;
		grid-template-columns: minmax(0, 1fr) 230px;
		gap: 3rem;
		align-items: start;
	}
	.content {
		min-width: 0;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.875rem;
		margin-bottom: 2.5rem;
	}
	.back:hover {
		color: var(--accent);
	}

	.hero {
		margin: 0 0 1.5rem;
	}
	.hero img {
		width: 100%;
		height: auto;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1rem;
	}
	.tag {
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		background: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
		text-decoration: none;
		transition: background 180ms ease, color 180ms ease;
	}
	.tag:hover {
		background: var(--accent);
		color: rgb(var(--contrast-fg));
	}
	h1 {
		font-family: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
		letter-spacing: -0.02em;
		line-height: 1.15;
		margin: 0 0 1.25rem;
	}
	.post-date {
		display: block;
		font-size: 0.875rem;
		color: rgb(var(--gray));
		margin-bottom: 2rem;
	}
	.last-updated {
		font-style: italic;
	}

	/* ── prose ── */
	.prose {
		color: rgb(var(--gray-dark));
		line-height: 1.7;
		font-size: 0.95rem;
	}
	.prose :global(h2) {
		font-family: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
		font-size: 1.3rem;
		margin: 2em 0 0.5em;
		color: rgb(var(--black));
		scroll-margin-top: 1.5rem;
	}
	.prose :global(h3) {
		font-family: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
		font-size: 1.1rem;
		margin: 1.6em 0 0.4em;
		color: rgb(var(--black));
		scroll-margin-top: 1.5rem;
	}
	.prose :global(p) {
		margin: 0 0 1em;
	}
	.prose :global(ul),
	.prose :global(ol) {
		padding-left: 1.5em;
		margin: 0 0 1em;
	}
	.prose :global(code) {
		background: rgb(var(--gray-light));
		padding: 0.1em 0.35em;
		border-radius: 3px;
		font-size: 0.9em;
	}
	.prose :global(strong) {
		color: rgb(var(--black));
	}
	.prose :global(pre) {
		background: rgb(var(--gray-light));
		padding: 1.25em;
		border-radius: 8px;
		overflow-x: auto;
		margin: 1.5em 0;
	}
	.prose :global(pre code) {
		background: none;
		padding: 0;
		font-size: 0.875rem;
	}

	/* ── table of contents ── */
	.toc {
		position: sticky;
		top: 5rem;
		align-self: start;
	}
	.toc-title {
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 0.9rem;
	}
	.toc ul {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 2px solid rgb(var(--gray-light));
	}
	.toc li {
		margin: 0;
	}
	.toc a {
		display: block;
		padding: 0.35rem 0 0.35rem 0.9rem;
		margin-left: -2px;
		border-left: 2px solid transparent;
		color: rgb(var(--gray));
		text-decoration: none;
		font-size: 0.85rem;
		line-height: 1.4;
		transition: color 160ms ease, border-color 160ms ease;
	}
	.toc li.lvl-3 a {
		padding-left: 1.9rem;
		font-size: 0.8rem;
	}
	.toc a:hover {
		color: var(--accent);
	}
	.toc a.active {
		color: var(--accent);
		font-weight: 600;
		border-left-color: var(--accent);
	}

	/* ── related articles ── */
	.related {
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
	}
	.related h2 {
		font-family: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
		font-size: 1.4rem;
		margin: 0 0 1.5rem;
		color: rgb(var(--black));
	}
	.related-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}
	.rel-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		padding: 1.1rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg-surface);
		text-decoration: none;
		transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease;
	}
	.rel-card:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px rgba(var(--gray), 15%);
		border-color: var(--accent);
	}
	.rel-card h3 {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 700;
		line-height: 1.35;
		color: rgb(var(--black));
	}
	.rel-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: auto;
	}
	.rel-tag {
		font-size: 0.68rem;
		font-weight: 600;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: var(--accent-tint);
		color: var(--accent);
	}

	@media (max-width: 980px) {
		.shell {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.toc {
			display: none;
		}
	}
	@media (max-width: 600px) {
		.shell {
			padding: 1.25em 1.25em 4em;
		}
		.related-grid {
			grid-template-columns: 1fr;
		}
	}
</style>

<script>
	// Reading progress bar
	const bar = document.getElementById('progress-bar');
	function onScroll() {
		const max = document.documentElement.scrollHeight - window.innerHeight;
		const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
		if (bar) bar.style.width = Math.min(100, Math.max(0, pct)) + '%';
	}
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();

	// Active TOC highlight via IntersectionObserver
	const links = Array.from(document.querySelectorAll('.toc a')) as HTMLAnchorElement[];
	if (links.length) {
		const map = new Map(links.map((a) => [a.getAttribute('href')!.slice(1), a]));
		const headings = Array.from(
			document.querySelectorAll('article.prose :is(h2, h3)')
		) as HTMLElement[];
		const obs = new IntersectionObserver(
			(entries) => {
				entries.forEach((e) => {
					if (e.isIntersecting) {
						links.forEach((l) => l.classList.remove('active'));
						const a = map.get(e.target.id);
						if (a) a.classList.add('active');
					}
				});
			},
			{ rootMargin: '0px 0px -70% 0px', threshold: 0 }
		);
		headings.forEach((h) => obs.observe(h));
	}
</script>
