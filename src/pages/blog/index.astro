---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// Use any to handle Astro 7's complex module shape
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const allPosts = Object.entries(
	import.meta.glob('/src/content/blog/*.md', { eager: true })
).map(([path, mod]: [string, any]) => {
	const rawFm = mod.frontmatter;
	const fm: Record<string, unknown> = typeof rawFm === 'function' ? rawFm() : (rawFm ?? {});
	const slug = path.split('/').pop()!.replace(/\.md$/, '');
	return {
		id: slug,
		title: String(fm.title ?? slug),
		description: String(fm.description ?? ''),
		pubDate: String(fm.pubDate ?? ''),
		tags: Array.isArray(fm.tags) ? fm.tags.map(String) : [],
	};
});

const posts = allPosts.sort(
	(a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
);

const base = import.meta.env.BASE_URL;

function formatDate(d: string) {
	try {
		return new Date(d).toLocaleDateString('zh-CN', {
			year: 'numeric',
			month: 'long',
			day: 'numeric',
		});
	} catch {
		return d;
	}
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
				max-width: 100%;
				margin: 0 auto;
				padding: 3em 1.5em 6em;
			}
			h1 {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: clamp(1.75rem, 3.5vw, 2.5rem);
				margin: 0 0 2.5rem;
			}
			ul {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
				gap: 2rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li a {
				display: block;
				text-decoration: none;
				color: inherit;
				padding: 1.5rem;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 12px;
				transition: border-color 200ms ease, box-shadow 200ms ease;
			}
			li a:hover {
				border-color: var(--accent);
				box-shadow: 0 4px 20px rgba(var(--accent), 0.1);
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin: 0 0 0.75rem;
			}
			.tag {
				font-size: 0.68rem;
				font-weight: 600;
				padding: 0.2rem 0.6rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			h2 {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: 1.2rem;
				margin: 0 0 0.5rem;
				color: rgb(var(--black));
			}
			.desc {
				font-size: 0.875rem;
				color: rgb(var(--gray));
				margin: 0 0 0.75rem;
				line-height: 1.5;
			}
			.date {
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}
			@media (max-width: 600px) {
				ul { grid-template-columns: 1fr; }
				main { padding: 2em 1em 4em; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>博客</h1>
			<ul>
				{posts.map((post) => (
					<li>
						<a href={`${base}blog/${post.id}/`}>
							<div class="tags">
								{post.tags.slice(0, 2).map((t) => (
									<span class="tag">{t}</span>
								))}
							</div>
							<h2>{post.title}</h2>
							<p class="desc">{post.description}</p>
							<p class="date">{formatDate(post.pubDate)}</p>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
