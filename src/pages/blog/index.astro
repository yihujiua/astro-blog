---
import FormattedDate from '../../components/FormattedDate.astro';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSortedPosts, readingMinutes } from '../../utils/posts';

const base = import.meta.env.BASE_URL;
const posts = await getSortedPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
---

<BaseLayout title={`博客 — ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main>
		<section class="page-head">
			<h1>Latest Articles</h1>
			<p class="sub">
				Showing {posts.length} articles · <a href={`${base}tags/`}>按标签浏览 →</a>
			</p>
			<span class="read-hint">Click to read</span>
		</section>

		{
			featured && (
				<a
					class="featured"
					href={`${base}blog/${featured.id}/`}
					aria-label={`阅读《${featured.data.title}》`}
				>
					<span class="featured-label">Featured</span>
					<h2 class="featured-title">{featured.data.title}</h2>
					<p class="featured-desc">{featured.data.description}</p>
					<div class="byline">
						<span class="avatar">{AUTHOR.slice(0, 2).toUpperCase()}</span>
						<span class="author">{AUTHOR}</span>
						<span class="dot">·</span>
						<span>
							<FormattedDate date={featured.data.pubDate} />
						</span>
						<span class="dot">·</span>
						<span>{readingMinutes(featured.body)} 分钟读完</span>
						<span class="read-link">Read article →</span>
					</div>
				</a>
			)
		}

		<div class="cards">
			{rest.map((post) => (
				<PostCard post={post} />
			))}
		</div>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 3em 1.5em 6em;
	}

	/* ── page head ── */
	.page-head {
		display: grid;
		grid-template-columns: 1fr auto;
		grid-template-rows: auto auto;
		align-items: center;
		gap: 0.5rem 1rem;
		padding: 1em 0 2em;
		border-bottom: 1px solid var(--border);
		margin-bottom: 2em;
	}
	.page-head h1 {
		grid-column: 1;
		grid-row: 1;
		font-family: var(--font-serif);
		font-size: clamp(2.25rem, 5vw, 3.25rem);
		line-height: 1;
		margin: 0;
		letter-spacing: -0.02em;
		color: rgb(var(--black));
	}
	.page-head .sub {
		grid-column: 1;
		grid-row: 2;
		margin: 0;
		color: rgb(var(--gray));
		font-size: 0.95rem;
	}
	.sub a {
		color: var(--accent);
		font-weight: 600;
	}
	.sub a:hover {
		text-decoration: underline;
	}
	.read-hint {
		grid-column: 2;
		grid-row: 1 / span 2;
		background: rgb(var(--black));
		color: rgb(var(--contrast-fg));
		font-size: 0.78rem;
		padding: 0.4rem 0.9rem;
		border-radius: 999px;
		justify-self: end;
		align-self: center;
		white-space: nowrap;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	/* ── featured ── */
	.featured {
		padding: 0.5em 0 2em;
		cursor: pointer;
		border-bottom: 1px solid var(--border);
		margin-bottom: 1.5em;
	}
	.featured-label {
		color: #e63946;
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.22em;
		display: inline-block;
		margin-bottom: 0.6rem;
	}
	.featured-title {
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: clamp(1.85rem, 4vw, 2.5rem);
		line-height: 1.15;
		margin: 0 0 0.75rem;
		color: rgb(var(--black));
		letter-spacing: -0.01em;
		font-weight: 700;
	}
	.featured-desc {
		color: rgb(var(--gray));
		margin: 0 0 1rem;
		max-width: 640px;
		line-height: 1.55;
		font-size: 1rem;
	}
	.featured .byline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
		font-size: 0.85rem;
		color: rgb(var(--gray));
		margin: 0 0 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.read-link {
		margin-left: 0.5rem;
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
		font-size: 0.9rem;
	}
	.read-link:hover {
		text-decoration: underline;
	}
	.dot {
		color: rgb(var(--gray));
	}
	.avatar {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		background: #e63946;
		color: white;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 700;
	}
	.author {
		color: rgb(var(--black));
		font-weight: 600;
	}

	/* ── cards ── */
	.cards {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	@media (max-width: 720px) {
		main {
			padding: 2em 1.25em 4em;
		}
		.featured {
			padding: 0.5em 0 1.5em;
		}
	}
</style>
