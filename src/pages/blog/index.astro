---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

// Vite glob — each value is the markdown module, frontmatter is a named export
const modules = import.meta.glob('/src/content/blog/*.md', { eager: true });
const base = import.meta.env.BASE_URL;

interface PostData {
	id: string;
	title: string;
	description: string;
	author: string;
	pubDate: string;
	tags: string[];
	body: string;
	readMinutes: number;
	thumb: string;
	thumbLabel: string;
}

const PALETTE = ['#2A2A2A', '#2A6F97', '#E63946', '#2D8659', '#2337FF'];
function thumbColor(seed: string): string {
	let h = 0;
	for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) | 0;
	return PALETTE[Math.abs(h) % PALETTE.length];
}

const data: PostData[] = Object.entries(modules)
	.map(([path, mod]) => {
		const rawFm = (mod as any).frontmatter;
		const fm: Record<string, unknown> = typeof rawFm === 'function' ? rawFm() : (rawFm ?? {});
		const slug = path.split('/').pop()!.replace(/\.md$/, '');
		const raw: string = (typeof (mod as any).rawContent === 'function' ? (mod as any).rawContent() : (mod as any).rawContent) ?? '';
		const stripped = raw
			.replace(/```[\s\S]*?```/g, ' ')
			.replace(/`[^`]*`/g, ' ')
			.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
			.replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
			.replace(/[#>*_\-]/g, ' ');
		const words = stripped.trim().split(/\s+/).filter(Boolean).length;
		const readMinutes = Math.max(1, Math.round(words / 280));
		const tags = Array.isArray(fm.tags) ? fm.tags.map(String) : [];
		const firstTag = tags[0] ?? slug;
		return {
			id: slug,
			title: String(fm.title ?? slug),
			description: String(fm.description ?? ''),
			author: 'yihujiua',
			pubDate: String(fm.pubDate ?? ''),
			tags,
			body: raw,
			readMinutes,
			thumb: thumbColor(firstTag),
			thumbLabel: firstTag,
		};
	})
	.sort((a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime());

const [featured, ...rest] = data;

function fmtDate(d: string) {
	return new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`博客 — ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			:root {
				--blog-accent: #16a34a;
				--blog-border: #e5e7eb;
				--blog-muted: #6b7280;
			}

			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 3em 1.5em 6em;
			}

			/* ── page head ── */
			.page-head {
				display: grid;
				grid-template-columns: 1fr auto;
				grid-template-rows: auto auto;
				align-items: center;
				gap: 0.5rem 1rem;
				padding: 1em 0 2em;
				border-bottom: 1px solid var(--blog-border);
				margin-bottom: 2em;
			}
			.page-head h1 {
				grid-column: 1;
				grid-row: 1;
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: clamp(2.25rem, 5vw, 3.25rem);
				line-height: 1;
				margin: 0;
				letter-spacing: -0.02em;
				color: rgb(var(--black));
			}
			.page-head .sub {
				grid-column: 1;
				grid-row: 2;
				margin: 0;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.read-hint {
				grid-column: 2;
				grid-row: 1 / span 2;
				background: var(--blog-border);
				color: var(--blog-muted);
				font-size: 0.78rem;
				padding: 0.4rem 0.9rem;
				border-radius: 999px;
				justify-self: end;
				align-self: center;
				white-space: nowrap;
			}

			/* ── featured ── */
			.featured {
				padding: 0.5em 0 2em;
				cursor: pointer;
				border-bottom: 1px solid var(--blog-border);
				margin-bottom: 1.5em;
			}
			.featured-label {
				color: var(--blog-accent);
				font-size: 0.85rem;
				font-weight: 600;
				display: inline-block;
				margin-bottom: 0.5rem;
			}
			.featured-title {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: clamp(1.85rem, 4vw, 2.5rem);
				line-height: 1.15;
				margin: 0 0 0.75rem;
				color: var(--blog-accent);
				letter-spacing: -0.01em;
			}
			.featured-desc {
				color: rgb(var(--gray));
				margin: 0 0 1rem;
				max-width: 640px;
				line-height: 1.55;
				font-size: 1rem;
			}
			.featured .byline {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.read-link {
				margin-left: 0.5rem;
				color: var(--blog-accent);
				font-weight: 600;
				text-decoration: none;
				font-size: 0.9rem;
			}
			.read-link:hover { text-decoration: underline; }
			.dot { color: rgb(var(--gray)); }

			.avatar {
				width: 1.5rem;
				height: 1.5rem;
				border-radius: 50%;
				background: linear-gradient(135deg, #6366f1, #8b5cf6);
				color: white;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				font-size: 0.7rem;
				font-weight: 700;
			}

			/* ── cards ── */
			.cards {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.card {
				display: flex;
				gap: 1.25rem;
				padding: 1.25rem;
				border: 1px solid var(--blog-border);
				border-radius: 12px;
				background: white;
				cursor: pointer;
				transition: box-shadow 200ms ease, transform 200ms ease;
			}
			.card:hover {
				box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
				transform: translateY(-1px);
			}
			.card-thumb {
				flex: 0 0 80px;
				width: 80px;
				height: 80px;
				border-radius: 8px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: white;
				font-weight: 700;
				font-size: 0.72rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				text-align: center;
				padding: 0.5rem;
				line-height: 1.15;
				word-break: break-word;
			}
			.card-body {
				flex: 1;
				display: flex;
				flex-direction: column;
				gap: 0.4rem;
				min-width: 0;
			}
			.card-meta-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
				font-size: 0.78rem;
				color: rgb(var(--gray));
			}
			.card-tag {
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.2rem 0.6rem;
				border-radius: 4px;
				font-weight: 600;
				font-size: 0.7rem;
			}
			.card-read { white-space: nowrap; }
			.card-title {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: 1.3rem;
				line-height: 1.2;
				margin: 0.15rem 0;
				color: rgb(var(--black));
				letter-spacing: -0.01em;
			}
			.card-desc {
				color: rgb(var(--gray));
				margin: 0;
				font-size: 0.9rem;
				line-height: 1.5;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}
			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				margin-top: 0.4rem;
				flex-wrap: wrap;
			}
			.byline-mini {
				display: flex;
				gap: 0.5rem;
				align-items: center;
				font-size: 0.82rem;
				color: rgb(var(--gray));
			}
			.byline-mini .author {
				color: rgb(var(--black));
				font-weight: 600;
			}
			.chips {
				display: flex;
				gap: 0.4rem;
				flex-wrap: wrap;
			}
			.chip {
				font-size: 0.7rem;
				font-weight: 600;
				padding: 0.25rem 0.6rem;
				border-radius: 4px;
				border: 1px solid var(--blog-accent);
				color: var(--blog-accent);
			}

			/* ── modal (unchanged) ── */
			.modal {
				position: fixed;
				inset: 0;
				background: rgba(15, 18, 25, 0.55);
				display: none;
				align-items: flex-start;
				justify-content: center;
				padding: 6vh 1.25em;
				z-index: 50;
				opacity: 0;
				transition: opacity 200ms ease;
				overflow-y: auto;
			}
			.modal.open {
				display: flex;
				opacity: 1;
			}
			.dialog {
				position: relative;
				background: white;
				width: min(720px, 100%);
				border-radius: 16px;
				padding: 2.5rem 3rem 2rem;
				box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
				transform: translateY(20px) scale(0.98);
				transition: transform 250ms ease;
			}
			.modal.open .dialog {
				transform: translateY(0) scale(1);
			}
			.close {
				position: absolute;
				top: 1rem;
				right: 1rem;
				width: 2.25rem;
				height: 2.25rem;
				border-radius: 50%;
				background: rgb(var(--gray-light));
				border: 0;
				color: rgb(var(--black));
				font-size: 1.1rem;
				cursor: pointer;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				transition: background 200ms ease, color 200ms ease;
			}
			.close:hover {
				background: var(--accent);
				color: white;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 0 0 1.25rem;
			}
			.tag {
				font-size: 0.72rem;
				font-weight: 600;
				padding: 0.3rem 0.75rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.tag.active {
				background: #d1fadf;
				color: #027a48;
			}
			.modal h2 {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: clamp(1.75rem, 3.4vw, 2.25rem);
				line-height: 1.15;
				margin: 0 0 1rem;
				color: rgb(var(--black));
				letter-spacing: -0.01em;
			}
			.byline {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				gap: 0.75rem;
				margin: 0 0 1.5rem;
				padding-bottom: 1.25rem;
				border-bottom: 1px solid rgb(var(--gray-light));
				font-size: 0.85rem;
				color: rgb(var(--gray));
			}
			.author {
				color: rgb(var(--black));
				font-weight: 600;
			}
			.body {
				color: rgb(var(--gray-dark));
				line-height: 1.7;
				font-size: 0.95rem;
				margin: 0 0 1.5rem;
				white-space: pre-wrap;
				word-wrap: break-word;
			}
			.body :global(h2) {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: 1.3rem;
				margin: 1.5em 0 0.5em;
				color: rgb(var(--black));
			}
			.body :global(p) { margin: 0 0 1em; }
			.body :global(ul),
			.body :global(ol) { padding-left: 1.5em; margin: 0 0 1em; }
			.body :global(code) {
				background: rgb(var(--gray-light));
				padding: 0.1em 0.35em;
				border-radius: 3px;
				font-size: 0.9em;
			}
			.body :global(strong) { color: rgb(var(--black)); }
			.body :global(pre) {
				background: rgb(var(--gray-light));
				padding: 1em;
				border-radius: 6px;
				overflow-x: auto;
				margin: 0 0 1em;
			}
			.body :global(pre code) {
				background: transparent;
				padding: 0;
			}
			.actions {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				margin-top: 1rem;
				padding-top: 1.25rem;
				border-top: 1px solid rgb(var(--gray-light));
				flex-wrap: wrap;
			}
			.back {
				color: rgb(var(--gray));
				text-decoration: none;
				font-size: 0.9rem;
			}
			.back:hover { color: var(--accent); }
			.chip.alt {
				border-color: #2563eb;
				color: #2563eb;
			}
			.chip.alt:hover {
				background: #2563eb;
				color: white;
			}

			@media (max-width: 720px) {
				main { padding: 2em 1.25em 4em; }
				.featured { padding: 0.5em 0 1.5em; }
				.card {
					flex-direction: column;
					padding: 1rem;
				}
				.card-thumb {
					width: 64px;
					height: 64px;
					flex-basis: 64px;
				}
				.card-title { font-size: 1.15rem; }
				.dialog { padding: 1.75rem 1.5rem 1.5rem; }
				.actions { flex-direction: column-reverse; align-items: stretch; }
				.chips { justify-content: flex-end; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head">
				<h1>Latest Articles</h1>
				<p class="sub">Showing {data.length} articles</p>
				<span class="read-hint">Click to read</span>
			</section>

			{featured && (
				<article class="featured" data-post-id={featured.id} role="button" tabindex="0">
					<span class="featured-label">Featured</span>
					<h2 class="featured-title">{featured.title}</h2>
					<p class="featured-desc">{featured.description}</p>
					<div class="byline">
						<span class="avatar">{featured.author.slice(0, 2).toUpperCase()}</span>
						<span class="author">{featured.author}</span>
						<span class="dot">·</span>
						<span>{fmtDate(featured.pubDate)}</span>
						<span class="dot">·</span>
						<span>{featured.readMinutes} min read</span>
						<a class="read-link" href="#">Read article →</a>
					</div>
				</article>
			)}

			<div class="cards">
				{rest.map((post) => (
					<article class="card" data-post-id={post.id} role="button" tabindex="0">
						<div class="card-thumb" style={`background:${post.thumb}`}>{post.thumbLabel}</div>
						<div class="card-body">
							<div class="card-meta-top">
								<span class="card-tag">{post.tags[0] ?? post.id}</span>
								<span class="card-read">{post.readMinutes} min read</span>
							</div>
							<h3 class="card-title">{post.title}</h3>
							<p class="card-desc">{post.description}</p>
							<div class="card-footer">
								<div class="byline-mini">
									<span class="avatar">{post.author.slice(0, 2).toUpperCase()}</span>
									<span class="author">{post.author}</span>
									<span class="dot">·</span>
									<span>{fmtDate(post.pubDate)}</span>
								</div>
								<div class="chips">
									{post.tags.map((t) => <span class="chip">{t}</span>)}
								</div>
							</div>
						</div>
					</article>
				))}
			</div>
		</main>
		<Footer />

		<div
			class="modal"
			id="article-modal"
			role="dialog"
			aria-modal="true"
			aria-labelledby="modal-title"
			aria-hidden="true"
		>
			<article class="dialog" id="modal-dialog">
				<button class="close" type="button" id="modal-close" aria-label="关闭">×</button>
				<div class="tags" id="modal-tags"></div>
				<h2 id="modal-title"></h2>
				<div class="byline">
					<span class="avatar" id="modal-avatar"></span>
					<span class="author" id="modal-author"></span>
					<span class="dot">·</span>
					<span id="modal-date"></span>
					<span class="dot">·</span>
					<span id="modal-read"></span>
				</div>
				<div class="body" id="modal-body"></div>
				<div class="actions">
					<a class="back" id="modal-back" href="#">← 返回文章列表</a>
					<div class="chips" id="modal-chips"></div>
				</div>
			</article>
		</div>

		<script type="application/json" id="posts-data" set:html={JSON.stringify(data)} />

		<script is:inline>
			(() => {
				const data = JSON.parse(
					document.getElementById('posts-data').textContent || '[]',
				);
				const base = document.querySelector('base')?.getAttribute('href') || '/astro-blog/';
				const modal = document.getElementById('article-modal');
				const titleEl = document.getElementById('modal-title');
				const tagsEl = document.getElementById('modal-tags');
				const avatarEl = document.getElementById('modal-avatar');
				const authorEl = document.getElementById('modal-author');
				const dateEl = document.getElementById('modal-date');
				const readEl = document.getElementById('modal-read');
				const bodyEl = document.getElementById('modal-body');
				const chipsEl = document.getElementById('modal-chips');
				const backEl = document.getElementById('modal-back');
				const closeBtn = document.getElementById('modal-close');
				let lastFocus = null;

				function md(text) {
					const escape = (s) =>
						s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
					const lines = escape(text).split(/\n/);
					const out = [];
					let inUl = false;
					let inOl = false;
					let inCode = false;
					let inP = false;
					const closeLists = () => {
						if (inUl) { out.push('</ul>'); inUl = false; }
						if (inOl) { out.push('</ol>'); inOl = false; }
					};
					const closeP = () => { if (inP) { out.push('</p>'); inP = false; } };
					for (const raw of lines) {
						const line = raw.trimEnd();
						if (line.startsWith('```')) {
							closeP(); closeLists();
							if (inCode) { out.push('</code></pre>'); inCode = false; }
							else { out.push('<pre><code>'); inCode = true; }
							continue;
						}
						if (inCode) { out.push(line); continue; }
						if (!line.trim()) { closeP(); closeLists(); continue; }
						const h = line.match(/^(#{1,6})\s+(.*)$/);
						if (h) {
							closeP(); closeLists();
							out.push(`<h${h[1].length}>${inline(h[2])}</h${h[1].length}>`);
							continue;
						}
						const ul = line.match(/^[-*+]\s+(.*)$/);
						if (ul) {
							closeP();
							if (!inUl) { closeLists(); out.push('<ul>'); inUl = true; }
							out.push(`<li>${inline(ul[1])}</li>`);
							continue;
						}
						const ol = line.match(/^\d+\.\s+(.*)$/);
						if (ol) {
							closeP();
							if (!inOl) { closeLists(); out.push('<ol>'); inOl = true; }
							out.push(`<li>${inline(ol[1])}</li>`);
							continue;
						}
						if (!inP) { closeLists(); out.push('<p>'); inP = true; } else { out.push('<br/>'); }
						out.push(inline(line));
					}
					closeP(); closeLists();
					if (inCode) out.push('</code></pre>');
					function inline(s) {
						return s
							.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
							.replace(/`([^`]+)`/g, '<code>$1</code>')
							.replace(/\*([^*]+)\*/g, '<em>$1</em>');
					}
					return out.join('');
				}

				function open(id) {
					const post = data.find((p) => p.id === id);
					if (!post) return;
					lastFocus = document.activeElement;
					titleEl.textContent = post.title;
					tagsEl.innerHTML = (post.tags || [])
						.map((t, i) => `<span class="tag${i === 0 ? ' active' : ''}">${t}</span>`)
						.join('');
					avatarEl.textContent = (post.author || '?').slice(0, 2).toUpperCase();
					authorEl.textContent = post.author;
					dateEl.textContent = post.pubDate;
					readEl.textContent = `${post.readMinutes} min read`;
					bodyEl.innerHTML = md(post.body || '');
					chipsEl.innerHTML = (post.tags || [])
						.map(
							(t, i) =>
								`<a class="chip${i > 0 ? ' alt' : ''}" href="#">More ${t}</a>`,
						)
						.join('');
					backEl.href = '#';
					modal.classList.add('open');
					modal.setAttribute('aria-hidden', 'false');
					document.body.style.overflow = 'hidden';
					setTimeout(() => closeBtn.focus(), 50);
				}

				function close() {
					modal.classList.remove('open');
					modal.setAttribute('aria-hidden', 'true');
					document.body.style.overflow = '';
					if (lastFocus && lastFocus.focus) lastFocus.focus();
				}

				document.querySelectorAll('[data-post-id]').forEach((el) => {
					el.addEventListener('click', () => open(el.dataset.postId));
					el.addEventListener('keydown', (e) => {
						if (e.key === 'Enter' || e.key === ' ') {
							e.preventDefault();
							open(el.dataset.postId);
						}
					});
				});
				closeBtn.addEventListener('click', close);
				modal.addEventListener('click', (e) => {
					if (e.target === modal) close();
				});
				document.addEventListener('keydown', (e) => {
					if (e.key === 'Escape' && modal.classList.contains('open')) close();
				});
			})();
