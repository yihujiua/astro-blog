---
import FormattedDate from '../../components/FormattedDate.astro';
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getSortedPosts, readingMinutes } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getSortedPosts();
	const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
	return tags.map((tag) => ({
		params: { tag },
		props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
	}));
}

interface Props {
	posts: Awaited<ReturnType<typeof getSortedPosts>>;
}

const { posts } = Astro.props;
const tag = Astro.params.tag!;
const base = import.meta.env.BASE_URL;
---

<BaseLayout title={`标签：${tag} — ${SITE_TITLE}`} description={`标签「${tag}」下的全部文章`}>
	<main>
		<PageIntro kicker="Tag — 标签" title={`#${tag}`} compact>
			<p>{posts.length} 篇文章 · <a href={`${base}tags/`}>全部标签 →</a></p>
		</PageIntro>

		<div class="cards">
			{
				posts.map((post) => (
					<a class="card" href={`${base}blog/${post.id}/`}>
						<div class="card-meta">
							<span>
								<FormattedDate date={post.data.pubDate} />
							</span>
							<span class="dot">·</span>
							<span>{readingMinutes(post.body)} min read</span>
						</div>
						<h2 class="card-title">{post.data.title}</h2>
						<p class="card-desc">{post.data.description}</p>
					</a>
				))
			}
		</div>

		<a class="back" href={`${base}blog/`}>← 博客列表</a>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 760px;
		margin: 0 auto;
		padding: 3em 1em 4em;
	}

	.cards {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin-bottom: 3rem;
	}
	.card {
		display: block;
		padding: 1.25rem;
		border: 2px dashed var(--border-soft);
		border-radius: var(--radius);
		background: var(--bg-surface);
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-sketch);
		transform: rotate(-0.4deg);
		transition: box-shadow 150ms ease, transform 150ms ease, border-color 150ms ease;
	}
	.card:nth-child(even) {
		transform: rotate(0.4deg);
	}
	.card:hover {
		box-shadow: var(--shadow-sketch-hover);
		transform: rotate(0deg);
		border-color: var(--border);
	}
	.card:hover .card-title {
		text-decoration: underline wavy var(--accent) 1.5px;
		text-underline-offset: 4px;
	}
	.card-meta {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}
	.dot {
		color: rgb(var(--gray-light));
	}
	.card-title {
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.2;
		margin: 0.35rem 0;
		color: rgb(var(--black));
		letter-spacing: -0.01em;
	}
	.card-desc {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}
	.back:hover {
		color: var(--accent-text);
	}
</style>
