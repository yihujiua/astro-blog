---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { allTags, getSortedPosts } from '../../utils/posts';

const base = import.meta.env.BASE_URL;
const posts = await getSortedPosts();
const tags = allTags(posts);
---

<BaseLayout title={`标签 — ${SITE_TITLE}`} description="按标签浏览全部文章">
	<main>
		<section class="intro">
			<p class="kicker">Tags — 标签</p>
			<h1>全部<em>标签</em></h1>
			<p>共 {tags.length} 个标签，{posts.length} 篇文章。点击标签查看对应文章。</p>
		</section>

		<div class="tag-grid">
			{
				tags.map(({ tag, count }) => (
					<a class="tag-card" href={`${base}tags/${tag}/`}>
						<span class="tag-name">#{tag}</span>
						<span class="tag-count">{count} 篇</span>
					</a>
				))
			}
		</div>

		<a class="back" href={`${base}blog/`}>← 博客列表</a>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 3em 1em 4em;
	}
	.intro {
		max-width: 640px;
		margin-bottom: 2.5em;
	}
	.kicker {
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--accent);
		margin: 0 0 1rem;
	}
	.kicker::before {
		content: '— ';
	}
	h1 {
		font-family: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
		font-size: clamp(2.5rem, 6vw, 3.5rem);
		line-height: 1.05;
		margin: 0 0 1rem;
	}
	h1 em {
		font-style: italic;
		color: var(--accent);
	}
	.intro p {
		color: rgb(var(--gray-dark));
		line-height: 1.7;
		margin: 0;
	}

	.tag-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1rem;
		margin-bottom: 3rem;
	}
	.tag-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.9rem 1.1rem;
		border: 1.5px dashed rgba(0, 0, 0, 0.25);
		border-radius: 10px;
		background: var(--bg-surface);
		text-decoration: none;
		box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.06);
		transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease;
	}
	.tag-card:hover {
		transform: translateY(-3px) rotate(-0.6deg);
		box-shadow: 4px 8px 18px rgba(0, 0, 0, 0.12);
		border-color: var(--accent);
	}
	.tag-name {
		font-family: ui-serif, Georgia, 'Times New Roman', 'Songti SC', 'SimSun', serif;
		font-weight: 700;
		color: rgb(var(--black));
		font-size: 1rem;
		word-break: break-word;
	}
	.tag-count {
		flex: 0 0 auto;
		font-size: 0.75rem;
		color: rgb(var(--gray));
		background: rgb(var(--gray-light));
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}
	.back:hover {
		color: var(--accent);
	}
</style>
