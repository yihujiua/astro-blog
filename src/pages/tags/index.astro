---
import PageIntro from '../../components/PageIntro.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { allTags, getSortedPosts } from '../../utils/posts';

const base = import.meta.env.BASE_URL;
const posts = await getSortedPosts();
const tags = allTags(posts);
---

<BaseLayout title={`标签 — ${SITE_TITLE}`} description="按标签浏览全部文章">
	<main>
		<PageIntro kicker="Tags — 标签" title="全部标签" em="标签">
			<p>共 {tags.length} 个标签，{posts.length} 篇文章。点击标签查看对应文章。</p>
		</PageIntro>

		<div class="tag-grid">
			{
				tags.map(({ tag, count }) => (
					<a class="tag-card" href={`${base}tags/${tag}/`}>
						<span class="tag-name">#{tag}</span>
						<span class="tag-count">{count} 篇</span>
					</a>
				))
			}
		</div>

		<a class="back" href={`${base}blog/`}>← 博客列表</a>
	</main>
</BaseLayout>

<style>
	main {
		max-width: 860px;
		margin: 0 auto;
		padding: 3em 1em 4em;
	}

	.tag-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1rem;
		margin-bottom: 3rem;
	}
	.tag-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.9rem 1.1rem;
		border: 2px dashed var(--border-soft);
		border-radius: var(--radius);
		background: var(--bg-surface);
		text-decoration: none;
		box-shadow: var(--shadow-sketch);
		transform: rotate(-0.5deg);
		transition: transform 150ms ease, box-shadow 150ms ease, border-color 150ms ease;
	}
	.tag-card:nth-child(even) {
		transform: rotate(0.5deg);
	}
	.tag-card:hover {
		transform: rotate(0deg);
		box-shadow: var(--shadow-sketch-hover);
		border-color: var(--border);
	}
	.tag-card:active {
		box-shadow: var(--shadow-sketch-sm);
		transform: translateY(1px);
	}
	.tag-name {
		font-family: var(--font-serif);
		font-weight: 700;
		color: rgb(var(--black));
		font-size: 1rem;
		word-break: break-word;
	}
	.tag-count {
		flex: 0 0 auto;
		font-size: 0.75rem;
		color: rgb(var(--gray));
		background: rgb(var(--gray-light));
		padding: 0.2rem 0.55rem;
		border-radius: var(--radius);
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		text-decoration: none;
		color: rgb(var(--gray));
		font-size: 0.875rem;
	}
	.back:hover {
		color: var(--accent-text);
	}
</style>
