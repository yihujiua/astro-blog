---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR, GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { categoryMeta, timelineEvents } from '../data/timeline';

const base = import.meta.env.BASE_URL;
const githubHandle = GITHUB_URL.replace('https://', '');
---

<BaseLayout title={`关于 · ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<style>
			main {
				max-width: 880px;
				margin: 0 auto;
				padding: 3em 1em 4em;
			}

			.timeline {
				position: relative;
				padding: 1rem 0;
			}
			.timeline::before {
				content: '';
				position: absolute;
				left: 50%;
				top: 0;
				bottom: 0;
				width: 0;
				border-left: 2px dashed var(--border-soft);
				transform: translateX(-50%);
			}

			.event {
				display: grid;
				grid-template-columns: 1fr 24px 1fr;
				align-items: center;
				margin: 1.25rem 0;
			}

			.card {
				background: var(--bg-surface);
				border: 2px dashed var(--border-soft);
				border-radius: var(--radius);
				padding: 1rem 1.25rem;
				position: relative;
				box-shadow: var(--shadow-sketch);
				transition: box-shadow 150ms ease, transform 150ms ease,
					border-color 150ms ease;
			}

			.event.left .card {
				grid-column: 1;
				margin-right: 1.5rem;
				text-align: right;
			}
			.event.right .card {
				grid-column: 3;
				margin-left: 1.5rem;
			}

			.card::after {
				content: '';
				position: absolute;
				top: 50%;
				width: 1.5rem;
				height: 1px;
				background: rgb(var(--gray-light));
				transition: background 200ms ease;
			}
			.event.left .card::after {
				right: -1.5rem;
			}
			.event.right .card::after {
				left: -1.5rem;
			}

			.node {
				grid-column: 2;
				width: 14px;
				height: 14px;
				border-radius: 50%;
				background: var(--bg-surface);
				border: 2px solid currentColor;
				justify-self: center;
				position: relative;
				z-index: 2;
				box-shadow: 0 0 0 4px var(--bg-page);
				transition: box-shadow 200ms ease, transform 200ms ease;
			}

			.event:hover .card {
				box-shadow: var(--shadow-sketch-hover);
				border-color: var(--border);
				transform: rotate(-0.5deg);
			}
			.event:hover .node {
				box-shadow: 0 0 0 4px var(--bg-page), 0 0 0 6px rgb(var(--gray-light));
				transform: scale(1.15);
			}
			.event:hover .card::after {
				background: currentColor;
			}

			.event.highlight .card {
				border-color: var(--marker);
				border-style: dashed;
				box-shadow: var(--shadow-sketch-hover);
			}

			.cat {
				font-family: var(--font-serif);
				font-style: italic;
				font-size: 0.8rem;
				font-weight: 700;
				margin: 0;
			}
			.title {
				margin: 0.25rem 0 0;
				font-size: 1.1rem;
				font-weight: 700;
				color: rgb(var(--black));
			}
			.date {
				margin: 0.15rem 0 0;
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.desc {
				margin: 0.5rem 0 0;
				font-size: 0.9rem;
				line-height: 1.55;
				color: rgb(var(--gray-dark));
			}

			.legend {
				display: flex;
				gap: 1.5rem;
				margin-top: 3rem;
				padding-top: 1.5rem;
				border-top: 1px solid rgb(var(--gray-light));
				font-size: 0.85rem;
				color: rgb(var(--gray));
				flex-wrap: wrap;
			}
			.legend-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}
			.legend-line {
				width: 1.25rem;
				height: 2px;
				background: rgb(var(--gray));
			}
			.legend-node {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				border: 2px solid rgb(var(--gray));
				background: var(--bg-surface);
			}
			.legend-card {
				width: 1.25rem;
				height: 0.75rem;
				border: 1px solid rgb(var(--gray));
				border-radius: 3px;
			}
			.legend-cats {
				display: flex;
				gap: 1rem;
				margin-left: auto;
				flex-wrap: wrap;
			}
			.legend-cats .cat {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				font-size: 0.8rem;
			}
			.legend-cats .dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				display: inline-block;
			}

			.contact {
				margin-top: 3rem;
				padding: 1.5rem;
				border: 2px dashed var(--border-soft);
				border-radius: var(--radius);
				background: var(--bg-surface);
				box-shadow: var(--shadow-sketch);
			}
			.contact p {
				margin: 0 0 0.5rem;
			}
			.contact a {
				font-weight: 600;
			}

			@media (max-width: 720px) {
				.timeline::before {
					left: 1rem;
				}
				.event {
					grid-template-columns: 1.75rem 1fr;
				}
				.event .node {
					grid-column: 1;
				}
				.event.left .card,
				.event.right .card {
					grid-column: 2;
					text-align: left;
					margin-left: 1rem;
					margin-right: 0;
				}
				.event.left .card::after,
				.event.right .card::after {
					left: -1rem;
					right: auto;
					width: 1rem;
				}
				.legend-cats {
					margin-left: 0;
				}
			}
	</style>

	<main>
			<PageIntro kicker="About — 个人简介" title="我的折腾旅程" em="折腾">
				<p>
					你好，我是 <strong>{AUTHOR}</strong> 👋。一个爱折腾的开发者，
					喜欢把脑子里的想法变成能跑的东西。
					这里记录我在智能家居、嵌入式开发、AI 应用和开源工具上的实践笔记。
				</p>
			</PageIntro>

			<section class="timeline" aria-label="项目时间线">
				{
				timelineEvents.map((ev) => {
					const meta = categoryMeta[ev.category];
						return (
							<div
								class:list={['event', ev.side, { highlight: ev.highlight }]}
								style={`color: ${meta.color};`}
							>
								<article class="card">
									<p class="cat">{meta.label}</p>
									<h3 class="title">{ev.title}</h3>
									<p class="date">{ev.date}</p>
									{ev.description && <p class="desc">{ev.description}</p>}
								</article>
								<div class="node" aria-hidden="true" />
							</div>
						);
					})
				}
			</section>

			<section class="contact">
				<p><strong>联系我 →</strong></p>
				<p>
					GitHub：
					<a href={GITHUB_URL} target="_blank" rel="noopener">
						{githubHandle}
					</a>
				</p>
				<p>欢迎一起折腾、一起交流项目想法。</p>
			</section>
	</main>
</BaseLayout>
