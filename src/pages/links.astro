---
import PageIntro from '../components/PageIntro.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { friendCategories } from '../data/friends';

const base = import.meta.env.BASE_URL;

const categories = friendCategories;

const initials = (name: string) =>
	name
		.replace(/[^\p{L}\p{N} ]/gu, '')
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((w) => w[0])
		.join('')
		.toUpperCase() || name.slice(0, 2);
---

<BaseLayout title={`友链 · ${SITE_TITLE}`} description="我收藏的朋友们与技术伙伴的链接。">
	<style>
			main {
				max-width: 960px;
				margin: 0 auto;
				padding: 3em 1em 4em;
			}

			/* ── category section ── */
			.cat-section {
				margin-bottom: 3rem;
			}
			.cat-head {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				margin: 0 0 1.5rem;
			}
			.cat-dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
				flex: 0 0 auto;
			}
			.cat-title {
				font-size: 1.05rem;
				font-weight: 700;
				color: rgb(var(--black));
				margin: 0;
			}
			.cat-rule {
				flex: 1;
				height: 1px;
				background: rgb(var(--gray-light));
			}

			/* ── circular card grid ── */
			.grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
				gap: 1.75rem 1rem;
			}
			.fl-card {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				text-decoration: none;
				color: inherit;
				padding: 0.5rem 0.25rem;
				border-radius: var(--radius);
				transition:
					background 200ms ease,
					box-shadow 200ms ease,
					transform 200ms ease;
			}
			.fl-card:hover {
				background: var(--bg-surface);
				box-shadow: var(--shadow-sketch-hover);
				transform: rotate(-1deg);
			}

			/* circular thumbnail（手绘涂鸦圆圈） */
			.fl-thumb {
				width: 76px;
				height: 76px;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				color: #fff;
				font-weight: 700;
				font-size: 1.4rem;
				letter-spacing: 0.02em;
				box-shadow: var(--shadow-sketch);
				transition: transform 200ms ease;
				will-change: transform;
			}
			.fl-card:hover .fl-thumb {
				transform: scale(1.12);
				animation: fl-jiggle 0.55s ease-in-out;
			}

			/* hover jitter: scale up + small shake */
			@keyframes fl-jiggle {
				0% {
					transform: rotate(0deg) scale(1.12);
				}
				20% {
					transform: rotate(-5deg) scale(1.12) translateY(-2px);
				}
				40% {
					transform: rotate(5deg) scale(1.12);
				}
				60% {
					transform: rotate(-4deg) scale(1.12);
				}
				80% {
					transform: rotate(2deg) scale(1.12);
				}
				100% {
					transform: rotate(0deg) scale(1.12);
				}
			}

			.fl-name {
				margin: 0.7rem 0 0;
				font-size: 0.92rem;
				font-weight: 600;
				color: rgb(var(--black));
			}

			/* info revealed on hover */
			.fl-info {
				max-height: 0;
				opacity: 0;
				overflow: hidden;
				transition:
					max-height 220ms ease,
					opacity 180ms ease,
					margin-top 220ms ease;
				margin-top: 0;
			}
			.fl-card:hover .fl-info,
			.fl-card:focus-visible .fl-info {
				max-height: 80px;
				opacity: 1;
				margin-top: 0.4rem;
			}
			.fl-desc {
				font-size: 0.78rem;
				line-height: 1.5;
				color: rgb(var(--gray));
				margin: 0 0 0.3rem;
			}
			.fl-go {
				font-size: 0.72rem;
				font-weight: 700;
				color: var(--accent-text);
			}

			.hint {
				margin-top: 2.5rem;
				padding: 1rem 1.25rem;
				border: 2px dashed var(--border-soft);
				border-radius: var(--radius);
				font-size: 0.85rem;
				color: rgb(var(--gray));
				line-height: 1.6;
			}
			.hint code {
				font-family: var(--font-mono);
				font-size: 0.82em;
				background: rgb(var(--gray-light));
				padding: 0.1em 0.35em;
				border-radius: var(--radius);
			}

			@media (prefers-reduced-motion: reduce) {
				.fl-card:hover .fl-thumb {
					animation: none;
				}
			}

			@media (max-width: 720px) {
				.grid {
					grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
					gap: 1.25rem 0.75rem;
				}
				/* touch devices: always show info */
				.fl-info {
					max-height: 80px;
					opacity: 1;
					margin-top: 0.4rem;
				}
			}
	</style>

	<main>
			<PageIntro kicker="Links — 友链" title="我收藏的伙伴" em="伙伴">
				<p>
					这里放着我常逛的技术博客、一起折腾的朋友，以及一些顺手的工具。
					鼠标滑过卡片，看看它们是谁 👀。
				</p>
			</PageIntro>

			{
				categories.map((cat) => (
					<section class="cat-section" aria-label={cat.label}>
						<div class="cat-head">
							<span class="cat-dot" style={`background:${cat.color}`} />
							<h2 class="cat-title">{cat.label}</h2>
							<span class="cat-rule" />
						</div>
						<div class="grid">
							{cat.links.map((link) => (
								<a
									class="fl-card"
									href={link.url}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`访问 ${link.name}`}
								>
									<div
										class="fl-thumb"
										style={`background:${link.color ?? cat.color}`}
									>
										{initials(link.name)}
									</div>
									<p class="fl-name">{link.name}</p>
									<div class="fl-info">
										<p class="fl-desc">{link.desc}</p>
										<span class="fl-go">访问 ↗</span>
									</div>
								</a>
							))}
						</div>
					</section>
				))
			}

			<p class="hint">
				想加自己的友链？打开 <code>src/data/friends.ts</code>，在
				<code>friendCategories</code> 数组里加一条即可 —— 分类、名称、链接、简介随你填。
			</p>
	</main>
</BaseLayout>
