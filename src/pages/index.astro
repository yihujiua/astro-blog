---
import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.page {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				padding: 5rem 1.5rem;
				text-align: center;
				max-width: 100%;
			}

			/* ── top eyebrow ── */
			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.75rem;
				margin-bottom: 3rem;
				color: rgb(var(--gray));
				font-family: var(--font-atkinson), system-ui, sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.18em;
				text-transform: uppercase;
			}
			.eyebrow .dot {
				width: 4px;
				height: 4px;
				border-radius: 50%;
				background: rgb(var(--gray));
				display: inline-block;
			}
			.eyebrow .accent {
				color: rgb(var(--black));
				font-weight: 700;
			}

			/* ── main title ── */
			.title {
				font-family: var(--font-atkinson), system-ui, sans-serif;
				font-weight: 700;
				font-size: clamp(3rem, 9vw, 6rem);
				line-height: 1;
				color: rgb(var(--black));
				letter-spacing: -0.03em;
				margin: 0 0 0.5em;
				max-width: 18ch;
			}
			.title .em {
				font-style: italic;
				color: var(--accent);
			}

			/* ── subtitle ── */
			.subtitle {
				max-width: 52ch;
				margin: 0 auto 3rem;
				color: rgb(var(--gray));
				font-size: 1.05rem;
				line-height: 1.65;
			}

			/* ── divider ── */
			.divider {
				margin: 0 auto 3rem;
				width: 48px;
				height: 2px;
				background: rgb(var(--gray-light));
			}

			/* ── buttons ── */
			.cta-row {
				display: flex;
				gap: 0.85rem;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 4.5rem;
			}
			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0.9em 1.8em;
				font-family: var(--font-atkinson), system-ui, sans-serif;
				font-size: 0.95rem;
				font-weight: 600;
				text-decoration: none;
				border-radius: 6px;
				cursor: pointer;
				transition: all 220ms ease;
				min-width: 170px;
				border: 1.5px solid;
			}
			.btn-primary {
				background: rgb(var(--black));
				color: white;
				border-color: rgb(var(--black));
			}
			.btn-primary:hover {
				background: var(--accent);
				border-color: var(--accent);
				color: white;
				transform: translateY(-2px);
			}
			.btn-ghost {
				background: transparent;
				color: rgb(var(--black));
				border-color: rgb(var(--black));
			}
			.btn-ghost:hover {
				background: rgb(var(--black));
				color: white;
				transform: translateY(-2px);
			}

			/* ── stats card ── */
			.stats {
				border: 1px solid rgb(var(--gray-light));
				background: white;
				padding: 1.75rem 3rem;
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 3rem;
				max-width: 640px;
				width: 100%;
				box-shadow: 0 2px 6px rgba(var(--gray), 6%);
			}
			.stat {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.35rem;
			}
			.stat-num {
				font-family: var(--font-atkinson), system-ui, sans-serif;
				font-weight: 700;
				font-size: 2.25rem;
				line-height: 1;
				color: rgb(var(--black));
				letter-spacing: -0.02em;
			}
			.stat-label {
				font-family: var(--font-atkinson), system-ui, sans-serif;
				font-size: 0.78rem;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}

			@media (max-width: 600px) {
				.page { padding: 3rem 1.25rem; }
				.eyebrow { margin-bottom: 2rem; }
				.title { font-size: clamp(2.5rem, 11vw, 4rem); }
				.stats {
					grid-template-columns: 1fr;
					gap: 1.25rem;
					padding: 1.5rem 2rem;
				}
			}
		</style>
	</head>
	<body>
		<section class="page">
			<div class="eyebrow">
				<span class="dot" aria-hidden="true"></span>
				<span class="accent">Sketches</span>
				<span class="dot" aria-hidden="true"></span>
				<span>Notes on Building</span>
				<span class="dot" aria-hidden="true"></span>
			</div>

			<h1 class="title">
				Every line<br />
				tells a <span class="em">story</span>.
			</h1>

			<p class="subtitle">
				手绘风的边框、纸张的肌理、笔迹的温度。不完美的线条，<br />
				却承载着想被你看见的那点心意。
			</p>

			<div class="divider" aria-hidden="true"></div>

			<div class="cta-row">
				<a class="btn btn-primary" href={`${base}blog/`}>Open Sketchbook</a>
				<a class="btn btn-ghost" href={`${base}about/`}>View the Rules</a>
			</div>

			<div class="stats" role="list">
				<div class="stat" role="listitem">
					<span class="stat-num">3</span>
					<span class="stat-label">Articles</span>
				</div>
				<div class="stat" role="listitem">
					<span class="stat-num">3</span>
					<span class="stat-label">Topics</span>
				</div>
				<div class="stat" role="listitem">
					<span class="stat-num">∞</span>
					<span class="stat-label">In Progress</span>
				</div>
			</div>
		</section>
	</body>
</html>
