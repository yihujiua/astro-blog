---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const base = import.meta.env.BASE_URL;
const total = Object.keys(import.meta.glob('/src/content/blog/*.md')).length;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 760px;
				margin: 0 auto;
				padding: 5em 1.5em 6em;
			}

			.hero {
				padding: 0 0 2.5em;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.hero h1 {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: clamp(2.25rem, 5vw, 3.5rem);
				line-height: 1;
				margin: 0 0 1.25rem;
				letter-spacing: -0.02em;
			}
			.hero h1 em {
				font-style: italic;
				color: var(--accent);
			}
			.hero p {
				max-width: 560px;
				color: rgb(var(--gray));
				line-height: 1.7;
				margin: 0 0 1.75rem;
			}

			.cta {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.7em 1.4em;
				background: rgb(var(--black));
				color: white;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 600;
				font-size: 0.95rem;
				transition: background 200ms ease, transform 200ms ease;
			}
			.cta:hover {
				background: var(--accent);
				transform: translateY(-1px);
			}

			.stats {
				display: flex;
				gap: 2.5rem;
				margin-top: 3em;
				padding-top: 2em;
				border-top: 1px solid rgb(var(--gray-light));
			}
			.stat {
				display: flex;
				flex-direction: column;
				gap: 0.25rem;
			}
			.stat-num {
				font-family: ui-serif, Georgia, 'Times New Roman', serif;
				font-size: 1.75rem;
				font-weight: 700;
				color: rgb(var(--black));
				line-height: 1;
			}
			.stat-label {
				font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
				font-size: 0.7rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				color: rgb(var(--gray));
			}

			@media (max-width: 720px) {
				main {
					padding: 3em 1.25em 4em;
				}
				.stats {
					gap: 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>我的<em>折腾</em>笔记</h1>
				<p>
					一个爱折腾的开发者，记录在智能家居、嵌入式开发、AI 与开源工具上的实践。
					把踩过的坑、跑通的方案、写过的代码都摊在这里。
				</p>
				<a class="cta" href={`${base}blog/`}>
					浏览全部 {total} 篇文章 →
				</a>
			</section>

			<section class="stats">
				<div class="stat">
					<span class="stat-num">{total}</span>
					<span class="stat-label">Articles</span>
				</div>
				<div class="stat">
					<span class="stat-num">3</span>
					<span class="stat-label">Topics</span>
				</div>
				<div class="stat">
					<span class="stat-num">2026</span>
					<span class="stat-label">Started</span>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
