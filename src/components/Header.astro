---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href={import.meta.env.BASE_URL}>{SITE_TITLE}</a></h2>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/">首页</HeaderLink>
				<HeaderLink href="/blog">博客</HeaderLink>
				<HeaderLink href="/archive">归档</HeaderLink>
				<HeaderLink href="/links">友链</HeaderLink>
				<HeaderLink href="/about">关于</HeaderLink>
				<HeaderLink href="/search">搜索</HeaderLink>
			</div>
			<div class="nav-actions">
				<button id="theme-toggle" class="round-btn" aria-label="切换暗色模式" aria-pressed="false">
					<!-- 月亮：亮色模式下显示，点击进入暗色 -->
					<svg class="icon-moon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M20 13A8 8 0 1 1 11 4a6.5 6.5 0 0 0 9 9Z" />
					</svg>
					<!-- 太阳：暗色模式下显示，点击回到亮色 -->
					<svg class="icon-sun" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.5 1.5M17.2 17.2l1.5 1.5M18.7 5.3l-1.5 1.5M6.8 17.2l-1.5 1.5" />
					</svg>
				</button>
				<!-- 仅移动端显示的菜单开关 -->
				<button id="nav-toggle" class="round-btn nav-toggle" aria-label="打开菜单" aria-expanded="false">
					<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
						<path d="M4 7h16M4 12h16M4 17h16" />
					</svg>
				</button>
			</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--bg-surface);
		border-bottom: 2px dashed var(--border-soft);
		font-family: var(--font-atkinson), system-ui, sans-serif;
	}
	h2 {
		margin: 0;
		font-size: 1em;
		font-weight: 700;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: rgb(var(--black));
	}
	h2 a:hover {
		color: var(--accent-text);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.nav-right {
		display: flex;
		align-items: center;
	}
	.internal-links {
		display: flex;
		align-items: center;
	}
	/* 导航链接自身的样式在 HeaderLink.astro 中（子组件作用域） */

	.nav-actions {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	/* 主题切换 / 菜单开关共用的手绘圆钮 */
	.round-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		padding: 0;
		border: 1.5px dashed rgb(var(--black));
		border-radius: 50%;
		background: transparent;
		color: rgb(var(--black));
		cursor: pointer;
		vertical-align: middle;
		transition: color 200ms ease, border-color 200ms ease, transform 200ms ease;
	}
	.round-btn:hover {
		color: var(--accent-text);
		border-color: var(--accent);
		transform: rotate(15deg);
	}
	.nav-toggle {
		display: none;
	}
	.icon-sun {
		display: none;
	}
	:global(html[data-theme='dark']) .icon-sun {
		display: block;
	}
	:global(html[data-theme='dark']) .icon-moon {
		display: none;
	}

	@media (max-width: 720px) {
		header {
			position: relative;
			padding: 0 0.75em;
		}
		.internal-links {
			display: none;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			background: var(--bg-surface);
			border-bottom: 2px dashed var(--border-soft);
			box-shadow: var(--shadow-sketch-lg);
			padding: 0.25em 0.9em 0.9em;
		}
		header.menu-open .internal-links {
			display: flex;
		}
		.nav-toggle {
			display: inline-flex;
		}
	}
</style>

<script>
	const root = document.documentElement;

	// ── 主题切换 ──
	const toggle = document.getElementById('theme-toggle');
	function syncPressed() {
		toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
	}
	syncPressed();

	toggle?.addEventListener('click', () => {
		const dark = root.dataset.theme !== 'dark';
		if (dark) root.dataset.theme = 'dark';
		else delete root.dataset.theme;
		try {
			localStorage.setItem('theme', dark ? 'dark' : 'light');
		} catch {}
		syncPressed();
	});

	// ── 移动端菜单开关 ──
	const headerEl = document.querySelector('header');
	const navToggle = document.getElementById('nav-toggle');
	function closeMenu() {
		headerEl?.classList.remove('menu-open');
		navToggle?.setAttribute('aria-expanded', 'false');
		navToggle?.setAttribute('aria-label', '打开菜单');
	}
	navToggle?.addEventListener('click', () => {
		const open = headerEl?.classList.toggle('menu-open');
		navToggle.setAttribute('aria-expanded', String(!!open));
		navToggle.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单');
	});
	// 点击菜单里的链接后收起；Escape 也可关闭
	document.querySelectorAll('.internal-links a').forEach((a) => a.addEventListener('click', closeMenu));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') closeMenu();
	});
</script>
