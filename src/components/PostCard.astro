---
import FormattedDate from './FormattedDate.astro';
import { AUTHOR } from '../consts';
import { readingMinutes } from '../utils/posts';
import type { Post } from '../utils/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const tag = post.data.tags[0] ?? post.id;

// 缩略图底色按标签哈希取色；纸色 #F5EFE1 上白字看不清，不在候选里
const THUMB_COLORS = ['#2A2A2A', '#2A6F97', '#E63946', '#2D8659', '#2337FF'];
function thumbColor(seed: string): string {
	let h = 0;
	for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) | 0;
	return THUMB_COLORS[Math.abs(h) % THUMB_COLORS.length];
}
---

<a class="card" href={`${base}blog/${post.id}/`} aria-label={`阅读《${post.data.title}》`}>
	<div class="card-thumb" style={`background:${thumbColor(tag)}`}>{tag}</div>
	<div class="card-body">
		<div class="card-meta-top">
			<span class="card-tag">{tag}</span>
			<span class="card-read">{readingMinutes(post.body)} 分钟读完</span>
		</div>
		<h3 class="card-title">{post.data.title}</h3>
		<p class="card-desc">{post.data.description}</p>
		<div class="card-extra">
			<div class="card-extra-date">
				<span class="avatar">{AUTHOR.slice(0, 2).toUpperCase()}</span>
				<span class="author">{AUTHOR}</span>
				<span class="dot">·</span>
				<span><FormattedDate date={post.data.pubDate} /></span>
			</div>
			<div class="card-extra-tags">
				{post.data.tags.map((t) => (
					<span class="chip">{t}</span>
				))}
			</div>
		</div>
	</div>
</a>

<style>
	/* 悬停只展开更多信息（作者、日期、全部标签），点击直接进文章，纯 CSS 无 JS */
	.card {
		display: flex;
		gap: 1.25rem;
		padding: 1.25rem;
		border: 1px solid var(--border);
		border-radius: 12px;
		background: var(--bg-surface);
		cursor: pointer;
		text-decoration: none;
		color: inherit;
		transition: box-shadow 200ms ease, transform 200ms ease;
		will-change: transform;
	}
	.card:hover {
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
		transform: translateY(-1px);
	}
	.card-thumb {
		flex: 0 0 80px;
		width: 80px;
		height: 80px;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: white;
		font-weight: 700;
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		text-align: center;
		padding: 0.5rem;
		line-height: 1.15;
		word-break: break-word;
	}
	.card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}
	.card-meta-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}
	.card-tag {
		background: var(--accent-tint);
		color: var(--accent);
		padding: 0.2rem 0.6rem;
		border-radius: 4px;
		font-weight: 700;
		font-size: 0.7rem;
		letter-spacing: 0.02em;
	}
	.card-read {
		white-space: nowrap;
	}
	.card-title {
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.2;
		margin: 0.15rem 0;
		color: rgb(var(--black));
		letter-spacing: -0.01em;
	}
	.card-desc {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		transition: -webkit-line-clamp 220ms ease;
	}
	.card:hover .card-desc,
	.card:focus-visible .card-desc {
		-webkit-line-clamp: 5;
	}
	.card-extra {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0;
		transition: max-height 220ms ease, opacity 180ms ease, margin-top 220ms ease;
		pointer-events: none;
	}
	.card-extra-date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.78rem;
	}
	.card-extra-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.card:hover .card-extra,
	.card:focus-visible .card-extra {
		max-height: 120px;
		opacity: 1;
		margin-top: 0.5rem;
		pointer-events: auto;
	}
	.card:hover,
	.card:focus-visible {
		transform: translateY(-3px) scale(1.015);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
	}
	.avatar {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: 50%;
		background: #e63946;
		color: white;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 700;
	}
	.author {
		color: rgb(var(--black));
		font-weight: 600;
	}
	.dot {
		color: rgb(var(--gray));
	}
	.chip {
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.25rem 0.6rem;
		border-radius: 4px;
		border: 1px solid var(--accent);
		color: var(--accent);
		background: var(--bg-surface);
		transition: background 200ms ease, color 200ms ease;
	}
	.chip:hover {
		background: var(--accent);
		color: rgb(var(--contrast-fg));
	}
	@media (hover: none) {
		/* 触屏设备：直接展示全部信息，不依赖悬停 */
		.card-extra {
			max-height: 120px;
			opacity: 1;
			margin-top: 0.5rem;
			pointer-events: auto;
		}
	}
	@media (max-width: 720px) {
		.card {
			flex-direction: column;
			padding: 1rem;
		}
		.card-thumb {
			width: 64px;
			height: 64px;
			flex-basis: 64px;
		}
		.card-title {
			font-size: 1.15rem;
		}
	}
</style>
