---
import FormattedDate from './FormattedDate.astro';
import { AUTHOR } from '../consts';
import { readingMinutes } from '../utils/posts';
import type { Post } from '../utils/posts';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const base = import.meta.env.BASE_URL;
const tag = post.data.tags[0] ?? post.id;

// 缩略图按标签哈希取规范低饱和四色：淡染底 + 同色虚线框 + 铅笔字，保证对比度
const THUMB_COLORS = [
	{ ink: '#E74C3C', wash: 'rgba(231, 76, 60, 0.16)' },
	{ ink: '#3498DB', wash: 'rgba(52, 152, 219, 0.16)' },
	{ ink: '#27AE60', wash: 'rgba(39, 174, 96, 0.16)' },
	{ ink: '#F39C12', wash: 'rgba(243, 156, 18, 0.2)' },
];
function thumbColor(seed: string) {
	let h = 0;
	for (let i = 0; i < seed.length; i++) h = (h * 31 + seed.charCodeAt(i)) | 0;
	return THUMB_COLORS[Math.abs(h) % THUMB_COLORS.length];
}
const thumb = thumbColor(tag);
---

<a class="card" href={`${base}blog/${post.id}/`} aria-label={`阅读《${post.data.title}》`}>
	<div
		class="card-thumb"
		style={`background:${thumb.wash}; border-color:${thumb.ink}`}
	>{tag}</div>
	<div class="card-body">
		<div class="card-meta-top">
			<span class="card-tag">{tag}</span>
			<span class="card-read">{readingMinutes(post.body)} 分钟读完</span>
		</div>
		<h3 class="card-title">{post.data.title}</h3>
		<p class="card-desc">{post.data.description}</p>
		<div class="card-extra">
			<div class="card-extra-date">
				<span class="avatar">{AUTHOR.slice(0, 2).toUpperCase()}</span>
				<span class="author">{AUTHOR}</span>
				<span class="dot">·</span>
				<span><FormattedDate date={post.data.pubDate} /></span>
			</div>
			<div class="card-extra-tags">
				{post.data.tags.map((t) => (
					<span class="chip">{t}</span>
				))}
			</div>
		</div>
	</div>
</a>

<style>
	/* 手绘卡片：虚线边框 + 铅笔偏移阴影 + 轻微倾斜；
	   悬停反馈短促直接（阴影加深 + 反向倾斜抖动），纯 CSS 无 JS */
	.card {
		display: flex;
		gap: 1.25rem;
		padding: 1.25rem;
		border: 2px dashed var(--border-soft);
		border-radius: var(--radius);
		background: var(--bg-surface);
		cursor: pointer;
		text-decoration: none;
		color: inherit;
		box-shadow: var(--shadow-sketch);
		transform: rotate(-0.4deg);
		transition: box-shadow 150ms ease, transform 150ms ease, border-color 150ms ease;
		will-change: transform;
	}
	.card:hover {
		box-shadow: var(--shadow-sketch-hover);
		border-color: var(--border);
		transform: rotate(0.4deg);
	}
	.card:active {
		/* 笔尖压纸：阴影收小、按压下沉 */
		box-shadow: var(--shadow-sketch-sm);
		transform: rotate(0.2deg) translateY(1px);
	}
	.card-thumb {
		flex: 0 0 80px;
		width: 80px;
		height: 80px;
		border-radius: var(--radius);
		border: 2px dashed;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgb(var(--black));
		font-weight: 700;
		font-size: 0.72rem;
		text-align: center;
		padding: 0.5rem;
		line-height: 1.15;
		word-break: break-word;
	}
	.card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}
	.card-meta-top {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.78rem;
		color: rgb(var(--gray));
	}
	.card-tag {
		background: var(--accent-tint);
		color: var(--accent-text);
		padding: 0.2rem 0.6rem;
		border-radius: var(--radius);
		border: 1.5px dashed var(--accent);
		font-weight: 700;
		font-size: 0.7rem;
	}
	.card-read {
		white-space: nowrap;
	}
	.card-title {
		font-family: var(--font-serif);
		font-size: 1.3rem;
		line-height: 1.2;
		margin: 0.15rem 0;
		color: rgb(var(--black));
		letter-spacing: -0.01em;
	}
	.card-title:hover {
		text-decoration: underline wavy var(--accent) 1.5px;
		text-underline-offset: 4px;
	}
	.card-desc {
		color: rgb(var(--gray));
		margin: 0;
		font-size: 0.9rem;
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.card-extra {
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin-top: 0;
		transition: max-height 180ms ease, opacity 150ms ease, margin-top 180ms ease;
		pointer-events: none;
	}
	.card-extra-date {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: rgb(var(--gray));
		font-size: 0.78rem;
	}
	.card-extra-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.card:hover .card-extra,
	.card:focus-visible .card-extra {
		max-height: 120px;
		opacity: 1;
		margin-top: 0.5rem;
		pointer-events: auto;
	}
	.avatar {
		width: 1.5rem;
		height: 1.5rem;
		border-radius: var(--radius);
		background: var(--marker);
		color: var(--paper);
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.7rem;
		font-weight: 700;
	}
	.author {
		color: rgb(var(--black));
		font-weight: 600;
	}
	.dot {
		color: rgb(var(--gray));
	}
	.chip {
		font-size: 0.7rem;
		font-weight: 600;
		padding: 0.25rem 0.6rem;
		border-radius: var(--radius);
		border: 1.5px dashed var(--accent);
		color: var(--accent-text);
		background: transparent;
		transition: background 150ms ease, color 150ms ease;
	}
	.chip:hover {
		/* 铅笔涂黑 */
		background: var(--pencil);
		color: var(--paper);
	}
	@media (hover: none) {
		/* 触屏设备：直接展示全部信息，不依赖悬停 */
		.card-extra {
			max-height: 120px;
			opacity: 1;
			margin-top: 0.5rem;
			pointer-events: auto;
		}
	}
	@media (max-width: 720px) {
		.card {
			flex-direction: column;
			padding: 1rem;
			transform: none;
		}
		.card-thumb {
			width: 64px;
			height: 64px;
			flex-basis: 64px;
		}
		.card-title {
			font-size: 1.15rem;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.card,
		.card:hover,
		.card:active {
			transform: none;
			transition: none;
		}
	}
</style>
