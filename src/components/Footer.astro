---
import { getCollection } from 'astro:content';
import { allTags } from '../utils/posts';

const today = new Date();
const base = import.meta.env.BASE_URL;

// “主题”列动态取站内真实存在的热门标签，避免链接失效
const posts = await getCollection('blog', ({ data }) =>
	import.meta.env.PROD ? !data.draft : true
);
const topTags = allTags(posts).slice(0, 4);
---

<footer>
	<div class="footer-inner">
		<div class="top">
			<div class="brand">
				<div class="logo-row">
					<span class="logo-mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />
						</svg>
					</span>
					<h3 class="brand-title">Sketched</h3>
				</div>
				<p class="brand-desc">
					个人技术笔记，折腾点好玩的东西：智能家居、AI 管家、嵌入式。
					<br />手绘风，保留一点不完美的温度。
				</p>
				<div class="palette" aria-label="主题色">
					<span class="swatch" style="background:#2A2A2A" title="Pencil #2A2A2A"></span>
					<span class="swatch" style="background:#F5EFE1" title="Paper #F5EFE1"></span>
					<span class="swatch" style="background:#e63946" title="Marker #e63946"></span>
					<span class="swatch" style="background:#2337ff" title="Accent #2337ff"></span>
					<span class="swatch" style="background:#2A6F97" title="Ink #2A6F97"></span>
					<span class="swatch" style="background:#2D8659" title="Leaf #2D8659"></span>
				</div>
			</div>

			<div class="cols">
				<div class="col">
					<h4 class="col-title">导航</h4>
					<a href={base}>首页</a>
					<a href={`${base}blog/`}>博客</a>
					<a href={`${base}tags/`}>标签</a>
					<a href={`${base}archive/`}>归档</a>
					<a href={`${base}links/`}>友链</a>
					<a href={`${base}about/`}>关于</a>
				</div>
				<div class="col">
					<h4 class="col-title">主题</h4>
					{topTags.map(({ tag, count }) => <a href={`${base}tags/${tag}/`}>{tag} ({count})</a>)}
				</div>
				<div class="col">
					<h4 class="col-title">链接</h4>
					<a href="https://github.com/yihujiua" target="_blank" rel="noopener">GitHub ↗</a>
					<a href={`${base}rss.xml`}>RSS 订阅</a>
					<a href="mailto:hi@yihujiua.com">写信给我</a>
				</div>
			</div>
		</div>

		<div class="divider" aria-hidden="true"></div>

		<div class="bottom">
			<div class="signature">
				<span>Sketched for</span>
				<span class="star" aria-hidden="true">✺</span>
				<span class="sig-name">yihujiua</span>
				<span class="squiggle" aria-hidden="true">
					<svg viewBox="0 0 40 8" width="32" height="6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
						<path d="M2 4 Q 7 0, 12 4 T 22 4 T 32 4 T 38 4" />
					</svg>
				</span>
			</div>
			<a class="back-btn" href={base}>
				<span aria-hidden="true">←</span>
				<span>Back to Home</span>
			</a>
		</div>

		<p class="copy">© {today.getFullYear()} yihujiua · 保留所有权利</p>
	</div>
</footer>

<style>
	footer {
		margin-top: 4em;
		padding: 3em 1.5em 2em;
		background: var(--bg-surface);
		border-top: 1px solid var(--border);
		color: rgb(var(--gray-dark));
		font-family: var(--font-atkinson), system-ui, sans-serif;
	}

	.footer-inner {
		max-width: 1200px;
		margin: 0 auto;
	}

	/* ── Top: brand + columns ── */
	.top {
		display: grid;
		grid-template-columns: 1.4fr 2fr;
		gap: 4rem;
		align-items: start;
	}

	/* Brand block */
	.logo-row {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.85rem;
	}
	.logo-mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border: 1.5px solid rgb(var(--black));
		border-radius: 4px;
		color: rgb(var(--black));
	}
	.brand-title {
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 1.4rem;
		font-weight: 700;
		margin: 0;
		color: rgb(var(--black));
		letter-spacing: -0.01em;
	}
	.brand-desc {
		max-width: 360px;
		font-size: 0.92rem;
		line-height: 1.65;
		color: rgb(var(--gray));
		margin: 0 0 1.25rem;
	}
	.palette {
		display: flex;
		gap: 0.45rem;
		flex-wrap: wrap;
	}
	.swatch {
		width: 22px;
		height: 22px;
		border: 1px solid var(--border);
		border-radius: 50%;
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
	}

	/* Column lists */
	.cols {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 2rem;
	}
	.col-title {
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		margin: 0 0 0.9rem;
		color: var(--accent);
	}
	.col a {
		display: block;
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.92rem;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		padding: 0.18rem 0;
		transition: color 200ms ease;
	}
	.col a:hover {
		color: var(--accent);
	}

	/* ── Divider ── */
	.divider {
		margin: 2.5rem 0 1.5rem;
		border-top: 1px solid var(--border);
	}

	/* ── Bottom: signature + back button ── */
	.bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	.signature {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.95rem;
		color: rgb(var(--gray));
	}
	.star {
		color: #e63946;
		font-size: 0.85rem;
	}
	.sig-name {
		font-weight: 700;
		color: rgb(var(--black));
	}
	.squiggle {
		display: inline-flex;
		color: rgb(var(--gray));
	}

	.back-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		color: rgb(var(--black));
		padding: 0.55rem 1.1rem;
		border: 1.5px solid rgb(var(--black));
		border-radius: 6px;
		background: var(--bg-surface);
		transition: all 200ms ease;
	}
	.back-btn:hover {
		background: var(--accent);
		color: rgb(var(--contrast-fg));
		transform: translateY(-1px);
	}

	.copy {
		text-align: center;
		font-family: var(--font-atkinson), system-ui, sans-serif;
		font-size: 0.78rem;
		color: rgb(var(--gray));
		margin: 1.5rem 0 0;
		letter-spacing: 0.05em;
	}

	/* Responsive */
	@media (max-width: 720px) {
		footer {
			padding: 2em 1.25em 1.5em;
		}
		.top {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
		.cols {
			grid-template-columns: repeat(3, 1fr);
			gap: 1.25rem;
		}
		.col a {
			font-size: 0.82rem;
		}
		.bottom {
			justify-content: center;
			text-align: center;
		}
	}
	@media (max-width: 480px) {
		.cols {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>