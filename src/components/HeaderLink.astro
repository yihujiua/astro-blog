---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;
const base = import.meta.env.BASE_URL;
const fullHref = href.startsWith(base)
	? href
	: href === '/'
		? base
		: base.replace(/\/$/, '') + href;
const pathname = Astro.url.pathname.replace(base, '');
const subpath = pathname.match(/[^\/]+/g);
const isActive = href === pathname || href === '/' + (subpath?.[0] || '');
---

<a href={fullHref} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		padding: 1em 0.5em;
		color: rgb(var(--black));
		text-decoration: none;
		font-weight: 600;
		transition: color 150ms ease;
	}
	a:hover {
		color: var(--accent-text);
	}
	/* 手绘波浪下划线标记当前页 */
	a.active {
		color: var(--accent-text);
		text-decoration: underline wavy var(--accent) 1.5px;
		text-underline-offset: 5px;
	}
	@media (max-width: 720px) {
		a {
			width: 100%;
			padding: 0.8em 0.25em;
			border-bottom: 2px dashed var(--border-soft);
		}
		a:last-child {
			border-bottom: none;
		}
	}
</style>
